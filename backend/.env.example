# Server
PORT=5000

# MongoDB (optional for now)
# Leave USE_DB unset or "false" to run with the built-in in-memory store (no database needed).
# Set USE_DB=true and provide MONGODB_URI once you're ready to connect a real MongoDB database.
USE_DB=false
MONGODB_URI=mongodb://127.0.0.1:27017/sri_enippagam

# CORS - the URL your React frontend runs on
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Admin creation (required only when running `node createAdmin.js`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-long-random-password

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ADMIN_PHONE_NUMBER=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Use the exact API template names from Meta; do not guess these values.
WHATSAPP_ORDER_CONFIRMATION_TEMPLATE=
WHATSAPP_ADMIN_ORDER_TEMPLATE=
WHATSAPP_ORDER_STATUS_TEMPLATE=

# Optional independent test values
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_TEMPLATE_NAME=
WHATSAPP_TEST_VARIABLES=[]
